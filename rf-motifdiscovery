use strict;
use Config;
use File::Basename;
use FindBin qw($Bin);
use Getopt::Long qw(:config no_ignore_case);
use Time::HiRes;
use threads;
use threads::shared;

use lib $Bin . "/lib";

use Core::Mathematics;
use Core::Statistics;
use Core::Utils;
use Data::IO::Sequence;
use Data::Sequence::Utils;
use Graphics::SeqLogo;
use Term::Constants qw(:screen);
use Term::Table;

$|++;

die "\n  [!] Error: This program requires ithreads." .
    "\n             Please recompile Perl with ithreads support and try again\n\n" unless(defined $Config{useithreads});

my ($help, $output, $overwrite, $kmer,
    $negSamplings, $fasta, $peaks,
    $io, $window, $negPeaks, $oneperseq,
    $countOccurrences, $noGeneralize,
    $minKmer, $maxKmer, $ngen, $nref, $maxWidth,
    $ecutoff, $nmotifs, $doShuffle,
    $consTolerance, $nucShuffle, $threads,
    $saveKmerTable, @discovered, @peaks, @iupacMerge,
    @negPeaks, @realPeaks, @searchPeaks, @widths, 
    %peaks, %negPeaks, %transcripts, %rows, %rowIndex,
    %iupac, %iupacSet);

do {

    local $SIG{__WARN__} = sub { };

    GetOptions( "h|help"                => \$help,
                "o|output=s"            => \$output,
                "ow|overwrite"          => \$overwrite,
                "sk|save-kmer-table"    => \$saveKmerTable,
                "k|kmer=i"              => \$kmer,
                "s|shuffle"             => \$doShuffle,
                "np|neg-samplings=i"    => \$negSamplings,
                "f|fasta=s"             => \$fasta,
                "r|regions=s"           => \$peaks,
                "nr|negative-regions=s" => \$negPeaks,
                "w|window=i"            => \$window,
                "e|evalue=s"            => \$ecutoff,
                "nm|n-motifs=i"         => \$nmotifs,
                "co|count-occurrences"  => \$countOccurrences,
                "ng|n-generalize=i"     => \$ngen,
                "nf|n-refine=i"         => \$nref,
                "mw|max-width=i"        => \$maxWidth,
                "mk|min-kmer=i"         => \$minKmer,
                "xk|max-kmer=i"         => \$maxKmer,
                "nog|no-generalize"     => \$noGeneralize,
                "ct|consTolerance=s"    => \$consTolerance,
                "ns|nuc-shuffling"      => \$nucShuffle,
                "p|processors=i"        => \$threads ) or help(1);

};

help() if ($help);

# Default
$threads ||= 1;
$negSamplings ||= 3;
$window ||= 50;
$consTolerance //= 0.2;
$ecutoff //= 1e-3;
$nmotifs ||= 3;
$ngen ||= 100;
$nref ||= 4;

%iupac = ( A => "A", C => "C", G => "G", U => "U",
           AC => "M", AG => "R", AU => "W", CG => "S", CU => "Y", GU => "K",
           ACG => "V", ACU => "H", AGU => "D", CGU => "B", ACGU => "N" );
%iupacSet = reverse %iupac;
@iupacMerge = ( [ "M", "A", "C" ], [ "R", "A", "G" ], [ "W", "A", "U" ], [ "S", "C", "G" ],
                [ "Y", "C", "U" ], [ "K", "G", "U" ], [ "V", "M", "G" ], [ "H", "M", "U" ],
                [ "D", "R", "U" ], [ "B", "S", "U" ], [ "N", "V", "U" ] );

# A width range is searched unless an explicit -k was given
if (defined $kmer) { @widths = ($kmer); }
else {

    $minKmer ||= 4;
    $maxKmer ||= 8;
    @widths = ($minKmer .. $maxKmer);
    $kmer = $minKmer;

}

$maxWidth ||= $widths[-1] + $widths[0];
$oneperseq = 1 if (!$countOccurrences);
$output ||= "rf_motifdiscovery/";
$output =~ s/\/?$/\//;
%rows = ( A => 0,
          C => 1,
          G => 2,
          U => 3 );
%rowIndex = map { $rows{$_} => $_ } keys %rows;

die "\n  [!] Error: No input FASTA file provided\n\n" if (!defined $fasta);
die "\n  [!] Error: Provided FASTA file doesn't exist\n\n" if (!-e $fasta);
die "\n  [!] Error: No input regions BED file provided\n\n" if (!defined $peaks);
die "\n  [!] Error: Provided regions BED file doesn't exist\n\n" if (!-e $peaks);
die "\n  [!] Error: Provided negative regions BED file doesn't exist\n\n" if (defined $negPeaks && !-e $negPeaks);
die "\n  [!] Error: Number of shufflings must be greater than 0\n\n" if ($negSamplings < 1);
die "\n  [!] Error: Number of motifs must be greater than 0\n\n" if ($nmotifs < 1);
die "\n  [!] Error: Maximum k-mer size must be >= minimum\n\n" if ($widths[-1] < $widths[0]);
die "\n  [!] Error: Minimum k-mer size must be >= 4\n\n" if (!@widths || $widths[0] < 4);
die "\n  [!] Error: Window size must be greater than 3\n\n" if ($window < 3);
die "\n  [!] Error: k-mer size must be >= 4\n\n" if ($kmer < 4);
die "\n  [!] Error: Consensus tolerance must be comprised between 0 and 1\n\n" if (!isnumeric($consTolerance) || !inrange($consTolerance, [0, 1]));
die "\n  [!] Error: E-value must be >= 0\n\n" if (!ispositive($ecutoff));
die "\n  [!] Error: No output folder specified\n\n" if (!defined $output);

print "\n[+] Making output directory...";

if (-e $output) {

    if ($overwrite) {

        my $error = rmtree($output);

        die "\n\n  [!] Error: " . $error . "\n\n" if ($error);

    }
    else { die "\n\n  [!] Error: Output directory already exists." .
               "\n      Please use -ow (or --overwrite) to overwrite output directory\n\n"; }

}

for (qw(logos matrices)) { if (my $error = mktree("${output}/$_", "755")) { die "\n  [!] Error: Unable to create output directory ($error)\n\n"; } }

print "\n[+] Loading reference...";

$io = Data::IO::Sequence->new(file => $fasta);

print "\n[+] Importing regions...";
%peaks = importPeakCenters($peaks);
%negPeaks = importPeakCenters($negPeaks) if (defined $negPeaks);

while(my $entry = $io->read()) {

    my ($id, $sequence, $length) = ($entry->id(), $entry->sequence(), $entry->length());

    if (exists $peaks{$id}) {

        push(@peaks, peakCenters2Seq($peaks{$id}, $sequence, $length));
        $transcripts{$id} = $sequence;

    }

    push(@negPeaks, peakCenters2Seq($negPeaks{$id}, $sequence, $length)) if (exists $negPeaks{$id});

}

@realPeaks = @peaks;
print " " . scalar(@peaks) . " positive" . (defined $negPeaks ? ", " . scalar(@negPeaks) . " negative " : " ") . "imported.";

die "\n\n [!] Error: No region imported. Please check your FASTA and BED input files and try again\n\n" if (!@peaks);

if ($negPeaks && !@negPeaks) {

    warn "\n\n [!] Warning: No negative region imported. Falling back to random sampling...\n";
    undef($negPeaks);

}

if (!defined $negPeaks) {

    if ($doShuffle) {

        print "\n[+] Shuffling sequences...\n";
        @negPeaks = shufflePeaks(@peaks);

    }
    else { # Random sampling

        print "\n[+] Random sampling negative sequences...";

        foreach my $id (sort keys %transcripts) {

            my ($sequence, $length, @randomCenters);
            $sequence = $transcripts{$id};
            $length = length($sequence);
            @randomCenters = map { int(rand($length)) } 1 .. scalar(@{$peaks{$id}}) * $negSamplings;
            push(@negPeaks, peakCenters2Seq(\@randomCenters, $sequence, $length));

        }

        print " " . scalar(@negPeaks) . " negative sequences sampled.\n";
        undef(%transcripts);

    }

}

undef(%peaks);
undef(%negPeaks);

while(@discovered < $nmotifs) {

    my ($matchData, $consensus, $regex, $pvalue, 
        $evalue, $fullMotif, $coreMotif, $extCoreMotif, 
        $bestMotif, $iter, $minw, $maxw, @significant, 
        @aligned, %aligned, %wordPos, %wordNeg,
        %matches, %totseqs, %rePvalues, %level);

    $iter = scalar(@discovered) + 1;
    ($minw, $maxw) = ($widths[0], $widths[-1]);

    print CLRRET . "[+] Counting words [Iteration #" . $iter . "]";

    foreach my $set ([\@peaks, \%wordPos], [\@negPeaks, \%wordNeg]) {

        my ($sequences, $counts) = @{$set};
        my $seqNo = 0;

        foreach my $sequence (@{$sequences}) {

            $seqNo++;

            foreach my $run (split(/[^ACGU]+/, $sequence)) {

                my $length = length($run);

                next if ($length < $minw);

                for (my $i = 0; $i <= $length - $minw; $i++) {

                    my $last = $length - $i;
                    $last = $maxw if ($last > $maxw);

                    for (my $w = $minw; $w <= $last; $w++) {

                        my $word = substr($run, $i, $w);
                        my $entry = $counts->{$word};

                        if (!defined $entry) { $counts->{$word} = [1, $seqNo]; }
                        elsif ($entry->[1] != $seqNo) { $entry->[0]++; $entry->[1] = $seqNo; }

                    }

                }

            }

        }

    }

    foreach my $word (keys %wordPos) {

        my ($pos, $neg) = ($wordPos{$word}->[0], exists $wordNeg{$word} ? $wordNeg{$word}->[0] : 0);

        $matches{$word} = { pos => $pos, neg => $neg };

        next if ($pos * scalar(@negPeaks) <= $neg * scalar(@peaks));

        $rePvalues{$word} = [ $pos, $neg, logFisher($pos, $neg, scalar(@peaks) - $pos,
                                                    scalar(@negPeaks) - $neg) ];

    }

        if (!@discovered && $saveKmerTable) {

        print CLRRET . "[+] Saving k-mer table [Iteration #$iter]";

        open(my $kh, ">", "${output}kmers.txt") or die "\n\n  [!] Error: Unable to write kmer table ($!)\n\n";
        print $kh join("\t", qw(kmer p-value posMatches totPositive negMatches totNegative)) . "\n";

        foreach my $word (sort { ($rePvalues{$a} ? $rePvalues{$a}->[2] : 0) <=>
                                 ($rePvalues{$b} ? $rePvalues{$b}->[2] : 0) } keys %matches) {

            my ($logp, $pvalue);
            $logp = exists $rePvalues{$word} ? $rePvalues{$word}->[2] : undef;
            # exp() underflows below ~-745, so anything past -690 is reported as <1e-300
            $pvalue = !defined $logp ? undef : ($logp < -690 ? 0 : exp($logp));

            print $kh join("\t", $word, !defined $pvalue ? "NA" : ($pvalue > 0 ? sprintf("%.2e", $pvalue) : "<1e-300"),
                                 $matches{$word}->{pos}, scalar(@peaks),
                                 $matches{$word}->{neg}, scalar(@negPeaks)) . "\n";

        }

        close($kh);

    }

    last if (!keys %rePvalues);

    %level = %rePvalues;

    foreach my $nAmbig (1 .. $widths[-1]) {

        my (%next, @top);

        last if (!keys %level);

        print CLRRET . "[+] Generalizing to $nAmbig ambiguous position(s) [Iteration #" . $iter . "]";

        @top = (sort { $level{$a}->[2] <=> $level{$b}->[2] } keys %level);
        @top = @top[0 .. ($#top < $ngen - 1 ? $#top : $ngen - 1)];

        generalizeREs(\@top, \%level, \%next, scalar(@peaks), scalar(@negPeaks));

        $rePvalues{$_} = $next{$_} for (keys %next);
        %level = %next;

    }

    print CLRRET . "[+] Scoring best candidates [Iteration #$iter]";

    my @finalists = (sort { $rePvalues{$a}->[2] <=> $rePvalues{$b}->[2] } keys %rePvalues);
    @finalists = @finalists[0 .. ($#finalists < $ngen - 1 ? $#finalists : $ngen - 1)];


    foreach my $re (@finalists) {

        my ($regex, $pos, $neg);
        $regex = iupac2regex($re);
        $pos = countMatching($regex, \@peaks);
        $neg = countMatching($regex, \@negPeaks);

        $rePvalues{$re} = [ $pos, $neg, logFisher($pos, $neg, scalar(@peaks) - $pos, scalar(@negPeaks) - $neg) ];
        $bestMotif = { pattern => $re, pos => $pos, neg => $neg, logp => $rePvalues{$re}->[2] } if (!defined $bestMotif || $rePvalues{$re}->[2] < $bestMotif->{logp});

    }

    last if (!defined $bestMotif);

    if (!$noGeneralize) {

        print CLRRET . "[+] Extending best motif [Iteration #" . $iter . "]";

        my $extended = extendCore($bestMotif->{pattern}, $widths[0], $widths[-1], $maxWidth, $ngen, \@peaks, \@negPeaks);

        if ($extended ne $bestMotif->{pattern}) {

            my ($regex, $pos, $neg);
            $regex = iupac2regex($extended);
            $pos = countMatching($regex, \@peaks);
            $neg = countMatching($regex, \@negPeaks);
            $rePvalues{$extended} = [ $pos, $neg, $pos * scalar(@negPeaks) > $neg * scalar(@peaks) ? logFisher($pos, $neg, scalar(@peaks) - $pos, scalar(@negPeaks) - $neg) : 0 ];

            $bestMotif = { pattern => $extended, pos => $pos, neg => $neg,
                           logp    => $rePvalues{$extended}->[2] } if ($rePvalues{$extended}->[2] < $bestMotif->{logp});

        }

        print CLRRET . "[+] Refining best motif [Iteration #$iter]";

        my ($refined, $record) = refineREs($bestMotif->{pattern}, $rePvalues{$bestMotif->{pattern}}, $nref, \@peaks, \@negPeaks, \%rePvalues);

        $bestMotif = { pattern => $refined, pos => $record->[0],
                       neg => $record->[1], logp => $record->[2] } if (defined $refined && $record->[2] < $bestMotif->{logp});

    }

    $kmer = length($bestMotif->{pattern});
    $coreMotif = $bestMotif->{pattern};
    $totseqs{pos} = scalar(@peaks);
    $totseqs{neg} = scalar(@negPeaks);

    @aligned = grep { exists $matches{$_} } @{expandIupac($coreMotif, 256) || []};
    @aligned = ($coreMotif) if (!@aligned);
    %aligned = map { $_ => 1 } @aligned;
    $extCoreMotif = $coreMotif;

    print CLRRET . "[+] Calculating final p-value [Iteration #$iter]";

    $matchData = { totalPos       => 0,
                   totalNeg       => 0,
                   totalPosPeaks  => scalar(@peaks),
                   totalNegPeaks  => scalar(@negPeaks),
                   pos            => 0,
                   neg            => 0,
                   posPeaks       => 0,
                   negPeaks       => 0,
                   matrix         => [] };

    @searchPeaks = @peaks;

    $matchData->{matrix} = seqs2matrix(\@aligned, \%matches);
    $extCoreMotif = matrix2consensus($matchData->{matrix});
    $regex = join("|", map { my $k = $_; $k =~ s/-//g; $k } @aligned);

    # Mask motifs in peaks
    for (@peaks) { $_ =~ s/($regex)/"X" x length($1)/ge; }

    $regex = iupac2regex($coreMotif);

    foreach my $sequence (@searchPeaks) {

        $matchData->{totalPos} += length($sequence) - $kmer + 1 if (!$oneperseq);
        my @matches = $sequence =~ m/(?:$regex)/g;
        $matchData->{pos} += scalar(@matches);
        $matchData->{posPeaks} += min(1, scalar(@matches));

    }

    foreach my $sequence (@negPeaks) {

        my $matches = () = $sequence =~ m/(?:$regex)/g;
        $matchData->{totalNeg} += length($sequence) - $kmer + 1 if (!$oneperseq);
        $matchData->{neg} += $matches;
        $matchData->{negPeaks} += min(1, $matches || 0);

    }

    $pvalue = $oneperseq ? fisher($matchData->{posPeaks} || 0, $matchData->{negPeaks} || 0,
                                  $matchData->{totalPosPeaks} - $matchData->{posPeaks},
                                  $matchData->{totalNegPeaks} - $matchData->{negPeaks})
                         : fisher($matchData->{pos} || 0, $matchData->{neg} || 0,
                                  $matchData->{totalPos} - $matchData->{pos},
                                  $matchData->{totalNeg} - $matchData->{neg});

    $evalue = $pvalue * scalar(keys %matches);

    last if ($evalue >= $ecutoff);

    $fullMotif = matrix2consensus($matchData->{matrix});
    outputMotif($matchData->{matrix}, $coreMotif, $fullMotif);

    # fisher() underflows to 0 for strongly enriched motifs, which would print as
    # 0.00e+00 and make the strongest hits look like the weakest
    push(@discovered, [ $coreMotif, $extCoreMotif,
                        $pvalue > 0 ? sprintf("%.2e", $pvalue) : "<1e-300",
                        $matchData,
                        $evalue > 0 ? sprintf("%.2e", $evalue) : "<1e-300" ]);

}

if (!@discovered) { print CLRRET . "\n  [!] No significantly enriched motif(s)\n"; }
else {

    print CLRRET . "[+] " . scalar(@discovered) . " significantly enriched motif(s):\n\n";

    my $table = Term::Table->new(indent => 2);
    $table->head("Motif", "Consensus", "\% positive", "\% negative", "p-value", "E-value");
    $table->row($_->[0], $_->[1], sprintf("%.2f", $_->[3]->{posPeaks} / $_->[3]->{totalPosPeaks} * 100),
                sprintf("%.2f", $_->[3]->{negPeaks} / $_->[3]->{totalNegPeaks} * 100),
                $_->[2], $_->[4]) for (@discovered);

    $table->print();

    print "\n";

}

print "\n[+] All done.\n\n";

sub shufflePeaks {

    my @seqs : shared;
    my @shuffledPeaks : shared;

    @seqs = (@_) x $negSamplings;

    my @pool = map { threads->create(sub {

        my @shuffled;

        while (1) {

            my $seq;

            { lock(@seqs);
              $seq = shift(@seqs); }

            last if (!defined $seq);

            push(@shuffled, $nucShuffle ? nshuffle($seq) : dishuffle($seq));

        }

        { lock(@shuffledPeaks);
          push(@shuffledPeaks, @shuffled); }

    }) } 1 .. $threads;

    $_->join() for(@pool);

    return(@shuffledPeaks);

}


sub seqs2matrix {

    my ($seqs, $matches) = @_;

    my (@seqs, @matrix);
    @seqs = @{$seqs};
    @matrix = map { [ (0) x 4 ] } 0 .. length($seqs->[0]) - 1;

    foreach my $seq (@seqs) {

        my @seq = split(//, $seq);
        $seq =~ s/-//g;

        for (0 .. $#seq) {

            next if ($seq[$_] eq "-");
            $matrix[$_]->[$rows{$seq[$_]}] = $matches->{$seq}->{pos} if ($matrix[$_]->[$rows{$seq[$_]}] < $matches->{$seq}->{pos});

        }

    }

    return(\@matrix);

}

sub matrix2consensus {

    my @matrix = @{$_[0]};

    my (@consensus);

    for my $i (0 .. $#matrix) {

        my ($maxValue, $tolerance, @indexes, @column);
        @column = map { $matrix[$i]->[$_] } 0 .. 3;
        $maxValue = max(@column);
        $tolerance = $maxValue * $consTolerance;
        @indexes = grep { inrange($column[$_], [$maxValue - $tolerance, $maxValue + $tolerance]) } 0 .. 3;
        push(@consensus, @indexes > 1 ? join("", map { $rowIndex{$_} } @indexes) : $rowIndex{$indexes[0]});

    }

    return(nt2iupac(@consensus));

}

sub outputMotif {

    my @matrix = @{$_[0]};
    my ($coreMotif, $consensus) = @_[1..2];

    my ($transfac, $logo);
    $transfac = "ID Motif_" . $coreMotif . "\n" .
                "BF RF_MotifDiscovery\n" .
                "P0 A C G U\n";

    for my $i (0 .. $#matrix) {

        my ($total, @column);
        @column = map { $matrix[$i]->[$_] } 0 .. 3;
        $total = sum(@column);
        @column = map { round($_ / $total * 100) } @column;
        $transfac .= sprintf("%01d", $i + 1) . " " . join(" ", @column) . " " . substr($consensus, $i, 1) . "\n";

    }

    $transfac .= "XX\n\/\/\n";

    open(my $fh, ">", "${output}matrices/motif_${coreMotif}.mat") or die "\n\n  [!] Error: Unable to write matrix file for motif $coreMotif (" . $! . ")\n\n";
    print $fh $transfac;
    close($fh);

    $logo = Graphics::SeqLogo->new( file   => "${output}logos/motif_${coreMotif}.svg",
                                    matrix => "${output}matrices/motif_${coreMotif}.mat",
                                    scale  => 3 );
    $logo->plot();

}

sub importPeakCenters {

    my $file = shift;

    my (%peaks);

    open(my $fh, "<", $file) or die "\n\n  [!] Error: Unable to read from input peaks BED file (" . $! . ")\n\n";
    while(<$fh>) {

        my @row = split(/\t/, $_);

        next if (@row < 3 || !ispositive(@row[1..2]) || !isint(@row[1..2]));

        my $center = round(mean(@row[1..2]));
        $peaks{$row[0]} = [] if (!exists $peaks{$row[0]});
        push(@{$peaks{$row[0]}}, $center);

    }
    close($fh);

    return(%peaks);

}

sub peakCenters2Seq {

    my ($centers, $sequence, $length) = @_;

    my (@peakSeqs);

    foreach my $center (@{$centers}) {

        next if ($center < 0 || $center > $length - 1);

        my ($start, $end);
        $start = $center - round($window / 2);
        $start = 0 if ($start < 0);
        $end = $center + round($window / 2);
        $end = $length - 1 if ($end >= $length);

        push(@peakSeqs, dna2rna(substr($sequence, $start, $end - $start + 1)));

    }

    return(@peakSeqs);

}



sub iupacSet { my $code = shift; return(exists $iupacSet{$code} ? $iupacSet{$code} : $code); }

sub setToIupac {

    my $set = join("", sort split(//, shift));

    return(exists $iupac{$set} ? $iupac{$set} : undef);

}

# Words of length k matched by an IUPAC pattern
sub expandIupac {

    my ($pattern, $limit) = @_;

    my @words = ("");

    foreach my $code (split(//, $pattern)) {

        my (@next);

        foreach my $prefix (@words) { push(@next, map { $prefix . $_ } split(//, iupacSet($code))); }

        return if (defined $limit && @next > $limit);

        @words = @next;

    }

    return(\@words);

}

sub alignmentFromRE {

    my ($re, $sequences) = @_;

    my ($regex, @alignment);
    $regex = iupac2regex($re);

    foreach my $sequence (@{$sequences}) { push(@alignment, $sequence =~ m/($regex)/g); }

    return(\@alignment);

}

sub bestOffset {

    my ($re, $flanks) = @_;

    my ($regex, $best, @counts);
    $regex = iupac2regex($re);

    foreach my $flank (@{$flanks}) { $counts[$-[0]]++ while ($flank =~ m/$regex/g); }

    $best = 0;

    for my $i (0 .. $#counts) { $best = $i if (defined $counts[$i] && (!defined $counts[$best] || $counts[$i] > $counts[$best])); }

    return($best);

}

sub findCoreIn {

    my ($posFlanks, $negFlanks, $minw, $maxw, $ngen) = @_;

    my (%wordPos, %wordNeg, %rePvalues, %level, $nPos, $nNeg);
    $nPos = scalar(@{$posFlanks});
    $nNeg = scalar(@{$negFlanks});

    return if (!$nPos || !$nNeg);

    foreach my $set ([$posFlanks, \%wordPos], [$negFlanks, \%wordNeg]) {

        my ($sequences, $counts) = @{$set};
        my $seqNo = 0;

        foreach my $sequence (@{$sequences}) {

            $seqNo++;

            foreach my $run (split(/[^ACGU]+/, $sequence)) {

                my $length = length($run);

                next if ($length < $minw);

                for (my $i = 0; $i <= $length - $minw; $i++) {

                    my $last = $length - $i;
                    $last = $maxw if ($last > $maxw);

                    for (my $w = $minw; $w <= $last; $w++) {

                        my $word = substr($run, $i, $w);
                        my $entry = $counts->{$word};

                        if (!defined $entry) { $counts->{$word} = [1, $seqNo]; }
                        elsif ($entry->[1] != $seqNo) { $entry->[0]++; $entry->[1] = $seqNo; }

                    }

                }

            }

        }

    }

    foreach my $word (keys %wordPos) {

        my ($pos, $neg) = ($wordPos{$word}->[0], exists $wordNeg{$word} ? $wordNeg{$word}->[0] : 0);

        next if ($pos * $nNeg <= $neg * $nPos);

        $rePvalues{$word} = [ $pos, $neg, logFisher($pos, $neg, $nPos - $pos, $nNeg - $neg) ];

    }

    return if (!keys %rePvalues);

    %level = %rePvalues;

    foreach my $nAmbig (1 .. $maxw) {

        my (%next, @top);

        last if (!keys %level);

        @top = (sort { $level{$a}->[2] <=> $level{$b}->[2] } keys %level);
        @top = @top[0 .. ($#top < $ngen - 1 ? $#top : $ngen - 1)];

        generalizeREs(\@top, \%level, \%next, $nPos, $nNeg);

        $rePvalues{$_} = $next{$_} for (keys %next);
        %level = %next;

    }

    my ($best) = sort { $rePvalues{$a}->[2] <=> $rePvalues{$b}->[2] } keys %rePvalues;

    return($best, $rePvalues{$best});

}

sub extendCore {

    my ($primary, $minw, $maxw, $maxWidth, $ngen, $peaks, $negPeaks) = @_;

    my ($width, $pad, $padded, $posAln, $negAln,
        @posLeft, @posRight, @negLeft, @negRight);
    $width = length($primary);
    $pad = $maxWidth - $width;

    return($primary) if ($pad < $minw);

    $padded = ("N" x $pad) . $primary . ("N" x $pad);
    $posAln = alignmentFromRE($padded, $peaks);
    $negAln = alignmentFromRE($padded, $negPeaks);

    return($primary) if (!@{$posAln} || !@{$negAln});

    @posLeft = map { substr($_, 0, $pad) } @{$posAln};
    @posRight = map { substr($_, $width + $pad) } @{$posAln};
    @negLeft = map { substr($_, 0, $pad) } @{$negAln};
    @negRight = map { substr($_, $width + $pad) } @{$negAln};

    my ($leftRE, $leftRec) = findCoreIn(\@posLeft, \@negLeft, $minw, $maxw, $ngen);
    my ($rightRE, $rightRec) = findCoreIn(\@posRight, \@negRight, $minw, $maxw, $ngen);

    return($primary) if (!defined $leftRE && !defined $rightRE);

    if (defined $rightRE && (!defined $leftRE || $rightRec->[2] < $leftRec->[2])) {

        my $spacer = bestOffset($rightRE, \@posRight);

        return($primary . ("N" x $spacer) . $rightRE);

    }

    my $spacer = $pad - length($leftRE) - bestOffset($leftRE, \@posLeft);
    $spacer = 0 if ($spacer < 0);

    return($leftRE . ("N" x $spacer) . $primary);

}

sub refineREs {

    my ($seed, $seedRecord, $nref, $peaks, $negPeaks, $scored) = @_;

    my (%candidates, %best, %done, $nPos, $nNeg);
    $nPos = scalar(@{$peaks});
    $nNeg = scalar(@{$negPeaks});
    %candidates = ($seed => $seedRecord);
    %best = %candidates;

    while (1) {

        my (%improved, @top);

        @top = (sort { $candidates{$a}->[2] <=> $candidates{$b}->[2] } keys %candidates);
        @top = @top[0 .. ($#top < $nref - 1 ? $#top : $nref - 1)];

        foreach my $re (@top) {

            next if (exists $done{$re});

            $done{$re} = 1;

            for my $i (0 .. length($re) - 1) {

                foreach my $symbol (qw(A C G U M R W S Y K V H D B N)) {

                    next if ($symbol eq substr($re, $i, 1));

                    my $candidate = $re;
                    substr($candidate, $i, 1) = $symbol;

                    # N is not allowed at either end
                    next if (substr($candidate, 0, 1) eq "N" ||
                             substr($candidate, -1) eq "N");

                    next if (exists $scored->{$candidate});

                    my ($regex, $pos, $neg, $logp);
                    $regex = iupac2regex($candidate);
                    $pos = countMatching($regex, $peaks);
                    $neg = countMatching($regex, $negPeaks);
                    $logp = $pos * $nNeg > $neg * $nPos ? logFisher($pos, $neg, $nPos - $pos, $nNeg - $neg) : 0;
                    $scored->{$candidate} = [ $pos, $neg, $logp ];

                    # only replacements that beat their parent are carried on
                    $improved{$candidate} = $scored->{$candidate} if ($logp < $candidates{$re}->[2]);

                }

            }

        }

        last if (!keys %improved);

        $best{$_} = $improved{$_} for (keys %improved);
        %candidates = %improved;

    }

    my ($winner) = sort { $best{$a}->[2] <=> $best{$b}->[2] } keys %best;

    return($winner, $best{$winner});

}

sub generalizeREs {

    my ($top, $level, $next, $nPos, $nNeg) = @_;

    foreach my $re (@{$top}) {

        my @code = split(//, $re);

        for my $i (0 .. $#code) {

            next if (length(iupacSet($code[$i])) > 1);

            my (%counts);

            foreach my $base (qw(A C G U)) {

                my $candidate = $re;
                substr($candidate, $i, 1) = $base;

                $counts{$base} = $level->{$candidate} if (exists $level->{$candidate});

            }

            foreach my $merge (@iupacMerge) {

                my ($code, $left, $right) = @{$merge};

                next if (!exists $counts{$left} || !exists $counts{$right});

                my ($p1, $n1, $p2, $n2, 
                    $pos, $neg, $candidate);
                ($p1, $n1) = @{$counts{$left}}[0, 1];
                ($p2, $n2) = @{$counts{$right}}[0, 1];

                $pos = sprintf("%.0f", ($p1 + $p2) - ($p1 * $p2 / $nPos));
                $neg = sprintf("%.0f", ($n1 + $n2) - ($n1 * $n2 / $nNeg));

                $counts{$code} = [ $pos, $neg, undef ];

                $candidate = $re;
                substr($candidate, $i, 1) = $code;

                next if (substr($candidate, 0, 1) eq "N" || substr($candidate, -1) eq "N");

                next if (exists $next->{$candidate});

                $next->{$candidate} = [ $pos, $neg, $pos * $nNeg > $neg * $nPos ? logFisher($pos, $neg, $nPos - $pos, $nNeg - $neg) : 0 ];

            }

        }

    }

}

sub countMatching {

    my ($re, $sequences) = @_;

    my $n = 0;

    foreach my $sequence (@{$sequences}) { $n++ if ($sequence =~ $re); }

    return($n);

}


